                  "pm.test('result_type', () => pm.expect([\"fallback\", \"personalized\"]).to.include(pm.response.json().result_type));",
                  "pm.test('10 ítems', () => pm.expect(pm.response.json().items.length).to.be.at.most(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-API-Key",
                "value": "{{api_key}}"
