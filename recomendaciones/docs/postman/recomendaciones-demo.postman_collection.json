{
  "info": {
    "name": "Recomendaciones · demo local",
    "description": "Endpoints de la API de recomendaciones y del api-general simulado. Levantar el stack con `docker compose up -d` desde la carpeta recomendaciones/ (ver docs/demo.md y docs/postman.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "demo_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "api_key",
      "value": "demo.clave-local-solo-para-la-demo"
    },
    {
      "key": "ana_id",
      "value": "87d0e2b0-b3ba-5d0a-90af-33694fa70903"
    },
    {
      "key": "tomas_id",
      "value": "b215a316-0b3b-54c4-a7a7-6084b723ccc6"
    },
    {
      "key": "usuario_inexistente_id",
      "value": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "item": [
    {
      "name": "1. API de recomendaciones (directa, puerto 8000)",
      "description": "La API real del servicio. Todo menos /health exige el header X-Internal-API-Key. Recorre el flujo con Ana, en orden: correr sobre un stack recién levantado (docker compose down -v; docker compose up -d).",
      "item": [
        {
          "name": "Salud: proceso vivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_url}}/health/live",
            "description": "Pública. Responde aunque Postgres o Redis estén caídos."
          }
        },
        {
          "name": "Salud: lista para atender",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
