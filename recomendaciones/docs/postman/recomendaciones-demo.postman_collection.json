              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_url}}/health/ready",
            "description": "Pública. 503 si Postgres o Redis no responden."
          }
        },
        {
          "name": "Salud: detalle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
