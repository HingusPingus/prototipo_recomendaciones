                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_url}}/health",
            "description": "Pública. Estado de cada dependencia y versión de configuración del motor."
          }
        },
        {
          "name": "Sin API key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.expect([401]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{api_url}}/internal/v1/recommendations/{{ana_id}}?module=peliculas",
            "description": "Sin el header, o con una key de otro entorno, la respuesta es siempre la misma (FR-059)."
          }
        },
        {
          "name": "Ana sin declaración → 412",
          "event": [
            {
              "listen": "test",
              "script": {
