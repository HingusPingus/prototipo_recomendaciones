        {
          "name": "Recomendaciones de Ana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test('result_type', () => pm.expect([\"fallback\", \"personalized\"]).to.include(pm.response.json().result_type));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-API-Key",
                "value": "{{api_key}}"
              }
