                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{api_url}}/internal/v1/recommendations/{{ana_id}}?module=peliculas",
            "description": "Sin declaración de gustos en el módulo no hay recomendaciones (FR-088)."
          }
        },
        {
          "name": "Declarar gustos de Ana (películas) → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
