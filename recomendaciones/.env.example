# Configuración por entorno de `recomendaciones` (T002). Copiar a `.env` y completar.
# NUNCA versionar valores reales: las credenciales se inyectan desde el entorno.
# Todos los parámetros operativos (FR-068) son OBLIGATORIOS: el proceso no arranca sin ellos.

RECO_ENVIRONMENT=dev
# Forma: <entorno>.<secreto>. El prefijo debe coincidir con RECO_ENVIRONMENT (FR-059).
RECO_INTERNAL_API_KEY=dev.CAMBIAR-por-un-secreto-de-32-caracteres

RECO_DATABASE_URL=postgresql+psycopg://reco:reco@localhost:5432/recomendaciones
RECO_REDIS_URL=redis://localhost:6379/0
RECO_AMQP_URL=amqp://guest:guest@localhost:5672/
RECO_API_GENERAL_BASE_URL=http://localhost:8080

# Archivo de configuración del motor activo en este entorno (src/recomendaciones/config/engine_config/)
RECO_ENGINE_CONFIG_FILE=v1.yaml

# --- TTLs de caché (data-model.md §3.1) ---
RECO_TTL_FRESH_SECONDS=86400
RECO_TTL_STALE_SECONDS=604800
RECO_TTL_FILTERS_SECONDS=3600
RECO_TTL_FALLBACK_SECONDS=21600
RECO_TTL_SUPPRESS_SECONDS=300
RECO_TTL_DEDUPE_SECONDS=86400

# --- Parámetros operativos (plan.md §2, RD-46) ---
RECO_IDEMPOTENCY_RETENTION_HOURS=168
# 18–24 meses (RD-53). Se toma el extremo conservador: puede acortarse, nunca alargarse (FR-068e).
RECO_SIGNAL_RETENTION_DAYS=730
RECO_SYNC_VOLUME_DELTA_RATIO=0.9
RECO_INTERACTION_RECALC_THRESHOLD=10
RECO_RECOMPUTE_REQUESTS_MAXLEN=100000
RECO_RECOMPUTE_REQUESTS_MAX_DELIVERIES=5
# Ventana de reentrega (RD-110), alineada con el broker de `notificaciones` (RABBITMQ_MESSAGE_TTL_MS = 24 h).
# No es solo un dato copiado: el worker declara sus colas con x-message-ttl = este valor, de modo que un evento
# no consumido en ese plazo vence a la DLQ propia. FR-068b exige RECO_SIGNAL_RETENTION_DAYS × 24 > este valor.
# Cambiarlo exige recrear las colas (quorum: argumentos inmutables); ver docs/runbook.md, «Reproceso desde DLQ».
RECO_EVENT_REDELIVERY_WINDOW_HOURS=24
# También es el x-delivery-limit de las colas (RABBITMQ_DELIVERY_LIMIT del broker = 5).
RECO_RETRY_MAX_ATTEMPTS=5
RECO_RETRY_BACKOFF_BASE_SECONDS=1
RECO_REDIS_TIMEOUT_SECONDS=0.5
RECO_API_GENERAL_TIMEOUT_SECONDS=10
RECO_WARMUP_RATE_PER_SECOND=50
